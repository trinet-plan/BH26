{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bh26.example/schema/va-spec-audit-envelope/1.1",
  "title": "BH26 VA-Spec evidence audit envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "envelope_schema_version": {"const": "1.1"},
    "profile": {"type": "string", "minLength": 1},
    "validated_by": {"type": "object"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "required": ["envelope_schema_version", "profile", "validated_by", "records"],
  "$defs": {
    "variant": {
      "type": "object",
      "properties": {
        "assembly": {"const": "GRCh38"},
        "chrom": {"type": "string"},
        "pos": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^[ACGT]+$"},
        "alt": {"type": "string", "pattern": "^[ACGT]+$"}
      },
      "required": ["assembly", "chrom", "pos", "ref", "alt"]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "criterion": {"type": "string", "minLength": 2},
        "status": {
          "enum": [
            "MET", "NOT_MET", "NOT_EVALUATED", "NOT_APPLICABLE",
            "MANUAL_REVIEW", "DEPRECATED"
          ]
        },
        "summary": {"type": "string", "minLength": 1},
        "evidenceItemIds": {
          "type": "array",
          "items": {"type": "string", "format": "iri-reference"},
          "uniqueItems": true
        },
        "provenance": {"type": "object"}
      },
      "required": ["criterion", "status", "summary", "evidenceItemIds", "provenance"]
    },
    "evidenceItem": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "format": "iri-reference"},
        "type": {"const": "StudyResult"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "extensions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {"name": {"type": "string"}, "value": {}},
            "required": ["name", "value"]
          }
        },
        "qualityMeasures": {"type": "object"}
      },
      "required": ["id", "type", "name", "description", "extensions", "qualityMeasures"]
    },
    "wrappedLine": {
      "type": "object",
      "properties": {
        "criterion": {"type": "string", "minLength": 2},
        "evidence_line": {"type": "object"},
        "assessment_details": {"$ref": "#/$defs/assessment"}
      },
      "required": ["criterion", "evidence_line", "assessment_details"]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "variant": {"$ref": "#/$defs/variant"},
        "criterion_assessments": {
          "type": "array",
          "items": {"$ref": "#/$defs/assessment"}
        },
        "evidence_lines": {
          "type": "array",
          "items": {"$ref": "#/$defs/wrappedLine"}
        },
        "referenced_evidence": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/evidenceItem"}
        }
      },
      "required": [
        "record_id", "variant", "criterion_assessments", "evidence_lines",
        "referenced_evidence"
      ]
    }
  }
}
